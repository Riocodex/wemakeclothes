PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Supabase project URL from Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key from Project Settings > API. Used with the caller's Bearer token so RLS applies.
SUPABASE_ANON_KEY=replace-with-anon-key

# Service role key from Project Settings > API. Server-only. Used for signup and Mongo import. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional. JWT secret from Project Settings > API. Not required at runtime because the API verifies tokens with Supabase Auth.
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# Optional Postgres URI from Project Settings > Database. Required to apply SQL migrations and to import auth.users hashes.
DATABASE_URL=postgresql://postgres:replace-with-database-password@db.your-project-ref.supabase.co:5432/postgres

# Import only. The marketplace API no longer connects to MongoDB at runtime.
# Used by `npm run import:mongo` to copy existing collections into Supabase without deleting Mongo data.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wemakeclothes
